{
  "name": "korchunk",
  "version": "0.1.1",
  "description": "Rule-based Korean sentence splitter and sentence-aware RAG chunker with original-text offsets. Zero dependencies, runs in Node, browsers and Deno.",
  "keywords": ["korean", "sentence", "splitter", "segmenter", "chunking", "rag", "text-splitter", "nlp", "한국어"],
  "license": "MIT",
  "author": "LeeGyeongPil",
  "homepage": "https://github.com/LeeGyeongPil/korchunk#readme",
  "repository": { "type": "git", "url": "git+https://github.com/LeeGyeongPil/korchunk.git" },
  "bugs": { "url": "https://github.com/LeeGyeongPil/korchunk/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": { "korchunk": "bin/korchunk.mjs" },
  "files": ["dist", "bin", "README.md", "README.en.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20.19" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/test.mjs",
    "eval": "node scripts/eval.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start": "node examples/quickstart.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
